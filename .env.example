# Empty = the teacher is off. Pixel still starts and runs on Laya alone.
GEMINI_API_KEY=
GEMINI_TEACHER_MODEL=models/gemini-2.5-flash-lite
# The miner runs offline, once per cluster, and writes a schema. Same cheap 2.5
# tier as the teacher; raise it here if drafts start failing validation.
GEMINI_MINER_MODEL=models/gemini-2.5-flash-lite
PIXEL_DB_PATH=./pixel.db
LAYA_MODEL=multilingual
LAYA_DEVICE=cpu
ROUTER_THRESHOLD=0.6
# 1 = start without Laya. Buttons and the UI work; /api/chat answers 503.
PIXEL_SKIP_MODEL=0

# Mine on every N-th unmined case in teacher_log.
MINER_BATCH=5
# Cosine similarity that joins two commands into one cluster. The usable band is
# narrow and was measured, not guessed: below ~0.87 clusters come out mixed and
# the miner spends a Gemini call on unrelated commands, past ~0.91 nothing
# reaches MINER_MIN_CLUSTER.
MINER_SIM=0.88
# Cases below this never become a skill — two are a coincidence, three a habit.
MINER_MIN_CLUSTER=3
# Share of a cluster the router must send to the candidate for it to be proposed.
# Routing coverage only: whether the candidate also reproduces the teacher's own
# plan is reported next to it as `agreement` and does not gate — the teacher
# improvises a different plan per case, so that bar was unreachable (JEB-1547).
MINER_MIN_MATCH=0.8

# Dislike share above which a skill is switched off automatically (strictly >).
SKILL_DISLIKE_LIMIT=0.30
# ...but never before this many ratings: one 👎 on a new skill's first use is
# noise, not a verdict.
SKILL_MIN_RATED=5
