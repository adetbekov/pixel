# Empty = the teacher is off. Pixel still starts and runs on Laya alone.
GEMINI_API_KEY=
GEMINI_TEACHER_MODEL=gemini-3.1-flash-lite
PIXEL_DB_PATH=./pixel.db
LAYA_MODEL=multilingual
LAYA_DEVICE=cpu
ROUTER_THRESHOLD=0.6
# 1 = start without Laya. Buttons and the UI work; /api/chat answers 503.
PIXEL_SKIP_MODEL=0
