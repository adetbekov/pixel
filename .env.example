# Empty = the teacher is off. Pixel still starts and runs on Laya alone.
GEMINI_API_KEY=
GEMINI_TEACHER_MODEL=gemini-3.1-flash-lite
# The miner runs offline, once per cluster, and writes a schema. Same cheap 2.5
# tier as the teacher; raise it here if drafts start failing validation.
GEMINI_MINER_MODEL=models/gemini-2.5-flash-lite
PIXEL_DB_PATH=./pixel.db
LAYA_MODEL=multilingual
LAYA_DEVICE=cpu
ROUTER_THRESHOLD=0.6
# 1 = start without Laya. Buttons and the UI work; /api/chat answers 503.
PIXEL_SKIP_MODEL=0

# Mine on every N-th unmined case in teacher_log.
MINER_BATCH=5
# Cosine similarity that joins two commands into one cluster. Above ~0.85 only
# near-identical phrasings group and the miner quietly proposes nothing.
MINER_SIM=0.75
# Cases below this never become a skill — two are a coincidence, three a habit.
MINER_MIN_CLUSTER=3
# Share of a cluster the candidate must route and reproduce to be proposed.
MINER_MIN_MATCH=0.8
