# Empty = the teacher is off. Pixel still starts and runs on Laya alone.
GEMINI_API_KEY=
GEMINI_TEACHER_MODEL=models/gemini-2.5-flash-lite
# The miner runs offline, once per cluster, and writes a schema. Same cheap 2.5
# tier as the teacher; raise it here if drafts start failing validation.
GEMINI_MINER_MODEL=models/gemini-2.5-flash-lite
PIXEL_DB_PATH=./pixel.db
LAYA_MODEL=multilingual
LAYA_DEVICE=cpu
# Confidence a skill needs to win the router. Measured on the live checkpoint,
# not guessed: 0.66 is the knee where wrong fires drop without costing a hit.
# It is a property of the option set, so re-run scripts/calibrate_router.py
# after changing the checkpoint or the skill library.
ROUTER_THRESHOLD=0.66
# 1 = start without Laya. Buttons and the UI work; /api/chat answers 503.
PIXEL_SKIP_MODEL=0

# Mine when the N-th mineable case arrives in teacher_log. Mineable, not
# merely unmined: a failed call and a declined answer are logged and never
# enter the pool, so they do not count and do not trigger a run.
MINER_BATCH=5
# Cosine that joins two commands into one cluster — used only by the FALLBACK
# grouper, when the teacher's grouping call fails. The usable band is narrow and
# was measured, not guessed: below ~0.87 clusters come out mixed, past ~0.91
# nothing reaches MINER_MIN_CLUSTER. Even inside it these vectors find about a
# third of the repeated intents, which is why they are no longer the main path.
MINER_SIM=0.88
# Cases below this never become a skill — two are a coincidence, three a habit.
MINER_MIN_CLUSTER=3
# Share of its cluster an accepted skill has to take off Gemini to be proposed,
# measured by routing every case exactly the way /api/chat will afterwards — the
# exact-`examples` lookup included. Two numbers are reported beside it and neither
# gates: `generalization` (the same share from the choice head alone, i.e. what an
# unlisted phrasing would get — it swings 0.40…1.00 on one cluster because the head
# scores the draft's own wording, JEB-1562; stored on the proposal and shown on the
# card beside this one, which is ~1.00 on every live draft, JEB-1581) and
# `agreement` (whether the candidate
# reproduces the teacher's plan — the teacher improvises a different one per case,
# so that bar was unreachable, JEB-1547).
MINER_MIN_MATCH=0.8
# Drafts one *identical* set of cases gets before the miner stops redrawing it.
# A refused cluster stays in the pool (mined=1 is set only on publication), so
# without this it is redrafted on every later run for ever — one paid generate
# call each time, for a case set nothing about has changed. Past the budget it is
# counted in GET /api/metrics as `clusters_stuck` and becomes a control for the
# backtest's over-broad check; a new case joining the cluster is a different case
# set and buys another draft (JEB-1579). Floored at 1: 0 would make every cluster
# read as out of budget on its first run and switch mining off entirely.
MINER_MAX_ATTEMPTS=3

# Dislike share above which a skill is switched off automatically (strictly >).
SKILL_DISLIKE_LIMIT=0.30
# ...but never before this many ratings: one 👎 on a new skill's first use is
# noise, not a verdict.
SKILL_MIN_RATED=5
